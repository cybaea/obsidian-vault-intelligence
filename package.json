{
  "name": "obsidian-vault-intelligence",
  "version": "9.7.3",
  "description": "Turn your Obsidian vault into an active knowledge partner. Dual-loop semantic search with graph-augmented relevance scoring, an interactive semantic galaxy view, and an AI gardener that keeps your notes organized. Supports Google Gemini, Ollama, Voyage AI, and local embedding models, with Model Context Protocol (MCP) tool integration.",
  "author": "Allan Engelhardt",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "preversion": "npm run lint && npm run build",
    "version": "node version-bump.mjs && git add manifest.json versions.json CHANGELOG.md",
    "lint": "node scripts/lint-security.mjs && eslint . && npm run lint:css && npm run lint:secrets && npm run lint:md",
    "lint:css": "stylelint '**/*.css'",
    "lint:secrets": "secretlint \"**/*\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "upgrade-transformers": "node scripts/upgrade-transformers.cjs",
    "docs:dev": "vitepress dev",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "release:prep": "node scripts/release-prep.mjs",
    "publish-pr": "bash scripts/publish-pr.sh",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "ai",
    "google-gemini-ai",
    "agentic-workflow",
    "semantic-search",
    "knowledge-management",
    "rag",
    "ontology",
    "pkm",
    "knowledge-graph",
    "local-first"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.2",
    "@types/node": "^24.12.4",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "esbuild": "0.28.2",
    "esbuild-plugin-inline-worker": "0.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-obsidianmd": "^0.4.0",
    "eslint-plugin-perfectionist": "^5.4.0",
    "globals": "^17.5.0",
    "graphology-types": "^0.24.8",
    "jiti": "^2.6.1",
    "markdownlint-cli2": "^0.23.0",
    "mermaid": "^11.17.0",
    "obsidian": "^1.12.2",
    "secretlint": "^13.0.2",
    "stylelint": "^17.11.1",
    "stylelint-config-standard": "^40.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.56.0",
    "vite": "^8.0.14",
    "vitepress": "2.0.0-alpha.19",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@msgpack/msgpack": "^3.1.3",
    "@orama/orama": "^3.1.18",
    "@orama/stopwords": "^3.1.18",
    "comlink": "^4.4.2",
    "events": "^3.3.0",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "protobufjs": "^8.6.3",
    "sigma": "^3.0.2",
    "zod": "^4.3.5",
    "zod-to-json-schema": "^3.25.1",
    "@huggingface/transformers": "4.2.0"
  },
  "overrides": {
    "global-agent": "^4.1.3",
    "esbuild": "0.28.2",
    "lodash-es": "4.18.1",
    "minimatch": "^10.0.0",
    "glob": "^13.0.0",
    "katex": "0.18.5",
    "smol-toml": "^1.6.1",
    "vite": "$vite",
    "@vitejs/plugin-vue": "^6.0.6",
    "vitepress": "2.0.0-alpha.19",
    "protobufjs": "$protobufjs",
    "uuid": "^14.0.0",
    "fetch-blob": "^4.0.0",
    "ip-address": "10.7.0",
    "node-domexception": "file:./scripts/stubs/node-domexception",
    "markdown-it": "^15.0.0",
    "brace-expansion": "^5.0.8",
    "js-yaml": "^5.2.2"
  }
}
